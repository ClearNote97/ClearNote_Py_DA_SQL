# Variables de entorno del proyecto
PYTHONPATH=${PYTHONPATH}:..

# === SQL Server (activo) ===
MSSQL_HOST=tu_host
MSSQL_USER=usuario
MSSQL_PASSWORD=password
# Driver ODBC. Debe COINCIDIR con el instalado en el contenedor (Dockerfile → msodbcsql17).
# Para Driver 18: instala msodbcsql18 en el Dockerfile y cambia esta línea.
MSSQL_DRIVER=ODBC Driver 17 for SQL Server
# Cifrado: el Driver 17 no lo fuerza (déjalo vacío). Con Driver 18 pon MSSQL_ENCRYPT=yes
# y, si el server usa cert autofirmado, MSSQL_TRUST_SERVER_CERT=yes.
MSSQL_ENCRYPT=
MSSQL_TRUST_SERVER_CERT=
# Opcionales (vacío = se omiten). MSSQL_NAME vacío = base POR DEFECTO del login;
# para explorar el server sin fijar base, usa MSSQL_NAME=master.
MSSQL_NAME=
MSSQL_PORT=

# === (OPCIONAL) PostgreSQL ===
# PG_HOST=
# PG_USER=
# PG_PASSWORD=
# PG_NAME=
# PG_PORT=

# === (OPCIONAL) Oracle ===
# ORACLE_HOST=
# ORACLE_USER=
# ORACLE_PASSWORD=
# ORACLE_NAME=
# ORACLE_PORT=

# === (OPCIONAL) Túnel SSH (ver README_AGENTS §11 Caso B; por defecto, conexión directa) ===
# SSH_HOST=
# SSH_USER=
# SSH_PASSWORD=
# SSH_PORT=
